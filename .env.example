# ---- Core ----
ENV=development
API_KEY=dev-local-key

# ---- Database (used by docker-compose; backend defaults to local sqlite otherwise) ----
DATABASE_URL=postgresql://sentinelx:sentinelx@db:5432/sentinelx

# ---- LLM ----
# Required: SentinelX's agents call OpenAI directly for all reasoning.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Observability (optional, LangSmith tracing) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentinelx

# ---- Tools ----
# Incoming webhook URL from a Slack app -> used for real-time incident alerts.
SLACK_WEBHOOK_URL=

# ---- Risk engine ----
RISK_APPROVAL_THRESHOLD=60

# ---- CORS ----
CORS_ORIGINS=*
