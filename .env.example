# ---- Core ----
ENV=development
API_KEY=dev-local-key

# ---- Database (used by docker-compose; backend defaults to local sqlite otherwise) ----
DATABASE_URL=postgresql://sentinelx:sentinelx@db:5432/sentinelx

# ---- LLM ----
# Leave OPENAI_API_KEY blank (and/or USE_MOCK_LLM=1) to run the whole platform
# with the built-in deterministic mock reasoning model -- zero cost, zero keys,
# fully demoable. Set a real key + USE_MOCK_LLM=0 to use GPT-4o-mini for real
# agent reasoning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=1

# ---- Observability (optional, LangSmith tracing) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentinelx

# ---- Tools ----
# Incoming webhook URL from a Slack app -> used for real-time incident alerts.
SLACK_WEBHOOK_URL=

# ---- Risk engine ----
RISK_APPROVAL_THRESHOLD=60

# ---- CORS ----
CORS_ORIGINS=*
